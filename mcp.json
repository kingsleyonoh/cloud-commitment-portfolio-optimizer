{
  "name": "cloud-commitment-portfolio-optimizer",
  "version": "0.1.0",
  "description": "MCP tool manifest stub for Cloud Commitment Portfolio Optimizer API operations.",
  "baseUrl": "http://localhost:8080",
  "tools": [
    { "name": "registerTenant", "method": "POST", "path": "/api/tenants/register", "description": "Register a tenant when self-registration is enabled" },
    { "name": "getCurrentTenant", "method": "GET", "path": "/tenants/me", "description": "Fetch current tenant profile" },
    { "name": "queueImport", "method": "POST", "path": "/api/imports", "description": "Queue a billing import" },
    { "name": "listImports", "method": "GET", "path": "/api/imports", "description": "List import batches" },
    { "name": "createPriceTable", "method": "POST", "path": "/api/price-tables", "description": "Upload/create a price table version" },
    { "name": "runForecast", "method": "POST", "path": "/api/forecast-runs", "description": "Queue a forecast run" },
    { "name": "runOptimizer", "method": "POST", "path": "/api/optimizer-runs", "description": "Queue an optimizer run with frozen inputs" },
    { "name": "getRecommendation", "method": "GET", "path": "/api/recommendations/{id}", "description": "Fetch recommendation detail" },
    { "name": "requestApproval", "method": "POST", "path": "/api/recommendations/{id}/request-approval", "description": "Request approval for recommendation" },
    { "name": "decideApproval", "method": "POST", "path": "/api/approvals/{id}/approve", "description": "Approve an approval request" },
    { "name": "runBacktest", "method": "POST", "path": "/api/backtests", "description": "Queue deterministic replay/backtest" },
    { "name": "getReport", "method": "GET", "path": "/api/reports/{source_type}/{source_id}", "description": "Fetch frozen report snapshot" },
    { "name": "getIntegrationStatus", "method": "GET", "path": "/api/integrations/status", "description": "Fetch optional adapter status" },
    { "name": "listNotifications", "method": "GET", "path": "/api/notifications", "description": "List in-app notifications" }
  ]
}
