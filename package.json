{
  "name": "cloud-commitment-portfolio-optimizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx apps/api/server.ts",
    "worker:dev": "tsx apps/worker/index.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@fastify/view": "^10.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "handlebars": "^4.7.8",
    "htmx.org": "^2.0.4",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
