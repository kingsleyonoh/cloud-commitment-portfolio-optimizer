{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/*"],
      "@apps/*": ["apps/*"]
    },
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "core/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "vitest*.config.ts",
    "playwright.config.ts",
    "tailwind.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "dist", "zig-out", ".zig-cache"]
}
