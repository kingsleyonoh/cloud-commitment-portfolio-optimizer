# Cloud Commitment Portfolio Optimizer
# Copy to .env for local development. Never commit real secrets.

# App
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:8080

# Local PostgreSQL / Redis / DuckDB / Object Storage
POSTGRES_DB=ccpo
POSTGRES_USER=ccpo
POSTGRES_PASSWORD=ccpo
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_URL=redis://localhost:6379
DUCKDB_TEMP_DIR=.tmp/duckdb
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_PATH=.data/objects
REPORT_STORAGE_PATH=.data/reports

# Tenant Management
SELF_REGISTRATION_ENABLED=true
DEFAULT_TENANT_NAME=Default
DEFAULT_ADMIN_EMAIL=
API_KEY_PREFIX=ccpo
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# Import / Pricing / Forecast / Optimizer
MAX_IMPORT_SIZE_MB=1024
IMPORT_WORKER_CONCURRENCY=2
PRICE_FIXTURE_PATH=tests/fixtures/pricing
PRICE_TABLE_STALE_DAYS=90
DEFAULT_FORECAST_METHOD=quantile_bootstrap
MIN_HISTORY_DAYS=90
FORECAST_RANDOM_SEED=20260616
FORECAST_WORKER_CONCURRENCY=2
OPTIMIZER_MAX_CANDIDATES=10000
OPTIMIZER_TIMEOUT_SECONDS=30
DEFAULT_DOWNSIDE_CONFIDENCE=0.95
MAX_PARALLEL_OPTIMIZER_RUNS=2
BACKTEST_MAX_MONTHS=24
BACKTEST_WORKER_CONCURRENCY=1
REPLAY_RANDOM_SEED=20260616

# Reports / Approvals
APPROVAL_EXPIRY_HOURS=168

# Optional Notification Hub
NOTIFICATION_HUB_ENABLED=false
NOTIFICATION_HUB_URL=http://localhost:3847
NOTIFICATION_HUB_API_KEY=

# Optional Workflow Automation Engine
WORKFLOW_ENGINE_ENABLED=false
WORKFLOW_ENGINE_URL=https://workflows.kingsleyonoh.com
WORKFLOW_ENGINE_API_KEY=
WORKFLOW_APPROVAL_WORKFLOW_ID=

# Disabled Future Invoice Reconciliation Placeholder
INVOICE_RECON_ENABLED=false
INVOICE_RECON_CONTRACT_VERIFIED=false
INVOICE_RECON_URL=
INVOICE_RECON_API_KEY=

# Observability / Analytics (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
POSTHOG_KEY=
POSTHOG_HOST=
