# App
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Production Compose-only public URL; must be explicit HTTPS and non-loopback.
APP_PUBLIC_URL=
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:8080
DEPLOYMENT_REGION=local
DATABASE_REGION=local

# Database / Queue
DATABASE_URL=postgresql://user@localhost:5432/ccpo
# Production Compose-only database credential; never commit a real value.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
DUCKDB_TEMP_DIR=.tmp/duckdb
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_PATH=.data/objects

# Tenant Management
SELF_REGISTRATION_ENABLED=false
SELF_REGISTRATION_PRODUCTION_ACK=false
# local resets on restart and does not coordinate processes; development/test only.
# Production enablement requires redis or an explicitly enforcing trusted_edge.
REGISTRATION_LIMITER_MODE=local
# Explicit immediate-proxy IP/CIDR allowlist only; never trust-all or hop count.
REGISTRATION_TRUSTED_PROXY_CIDRS=
REGISTRATION_EDGE_ENFORCES_LIMIT=false
# Protected users routes: local is development/test only; production defaults to shared Redis.
USERS_LIMITER_MODE=local
# trusted_edge requires both this explicit acknowledgement and an immediate-proxy allowlist.
USERS_TRUSTED_EDGE_ACK=false
USERS_TRUSTED_PROXY_CIDRS=
DEFAULT_TENANT_NAME=Default
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_NAME=
# Jointly required path for a fresh configured admin; never password text.
DEFAULT_ADMIN_PASSWORD_FILE=
API_KEY_PREFIX=ccpo
# Required for session issuance: readable regular PEM RSA private key (RSA >= 2048 bits).
# Its derived public SPKI must exactly match JWT_PUBLIC_KEY_PATH; verification never reads it.
JWT_PRIVATE_KEY_PATH=
# Required in production: readable regular PEM RSA public-key file (RSA >= 2048 bits).
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=ccpo
JWT_AUDIENCE=ccpo-ui
JWT_ACCESS_TOKEN_MAX_LIFETIME_SECONDS=900
JWT_CLOCK_TOLERANCE_SECONDS=30
# In-process Argon2 bounds; hard maxima are 2 active and 32 queued.
AUTH_ARGON_CONCURRENCY=2
AUTH_ARGON_QUEUE_LIMIT=32
# Production requires Redis; local is loopback development/test only.
AUTH_LIMITER_MODE=local
# Auth-only immediate-proxy IP/CIDR allowlist; no trust-all or hop-count mode.
AUTH_TRUSTED_PROXY_CIDRS=
# false is allowed only with an unprefixed cookie set on loopback development/test.
AUTH_COOKIE_SECURE=false

# Import / Pricing / Forecast / Optimizer
MAX_IMPORT_SIZE_MB=1024
IMPORT_WORKER_CONCURRENCY=2
PRICE_FIXTURE_PATH=tests/fixtures/pricing
PRICE_TABLE_STALE_DAYS=90
DEFAULT_FORECAST_METHOD=quantile_bootstrap
MIN_HISTORY_DAYS=90
FORECAST_RANDOM_SEED=20260616
FORECAST_WORKER_CONCURRENCY=2
OPTIMIZER_MAX_CANDIDATES=10000
OPTIMIZER_TIMEOUT_SECONDS=30
DEFAULT_DOWNSIDE_CONFIDENCE=0.95
MAX_PARALLEL_OPTIMIZER_RUNS=2
BACKTEST_MAX_MONTHS=24
BACKTEST_WORKER_CONCURRENCY=1
REPLAY_RANDOM_SEED=20260616

# Reports / Approvals
REPORT_STORAGE_PATH=.data/reports
APPROVAL_EXPIRY_HOURS=168

# Notification Hub (optional)
NOTIFICATION_HUB_ENABLED=false
NOTIFICATION_HUB_URL=http://localhost:3847
NOTIFICATION_HUB_API_KEY=

# Workflow Automation Engine (optional)
WORKFLOW_ENGINE_ENABLED=false
WORKFLOW_ENGINE_URL=https://workflows.kingsleyonoh.com
WORKFLOW_ENGINE_API_KEY=
WORKFLOW_APPROVAL_WORKFLOW_ID=

# Invoice Reconciliation Engine (disabled future placeholder; endpoint TBD)
INVOICE_RECON_ENABLED=false
INVOICE_RECON_CONTRACT_VERIFIED=false
INVOICE_RECON_URL=
INVOICE_RECON_API_KEY=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
POSTHOG_KEY=
POSTHOG_HOST=

# Demo/public safety
DEMO_MODE=true
